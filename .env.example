# Copy this file to a local dotenv file and fill in your API keys.
# Never commit that local dotenv file to git.

# ==============================================================================
# SERVER PORTS (optional - defaults shown)
# ==============================================================================

# API/backend port (uvicorn). Defaults in README, PM2, and Procfile.dev use 8001.
PORT=8001

# Frontend dev server port (Vite, dev mode only).
UI_PORT=5173

# ==============================================================================
# REQUIRED
# ==============================================================================

# Fireworks AI -- primary LLM for screening, extraction, writing, and config generation.
# Task-tier defaults in config/settings.yaml: flash-0731 (bulk), gpt-oss-120b (adjudicator),
# pro-0813 (extraction/writing), minimax-m3 (PDF vision). Verify ids via live API before changing.
# Get a key at https://fireworks.ai/
FIREWORKS_API_KEY=your-fireworks-api-key

# OpenAlex -- required since Feb 2026; register free at https://openalex.org/sign-up
OPENALEX_API_KEY=your-openalex-api-key

# PubMed/NCBI -- any valid email; used by Biopython Entrez
# Also accepted as NCBI_EMAIL (legacy alias; PUBMED_EMAIL takes precedence)
PUBMED_EMAIL=your-email@example.com

# ==============================================================================
# OPTIONAL (improve coverage and rate limits)
# ==============================================================================

# Google Gemini -- required for diagram image generation agents (google: models in settings.yaml)
# GEMINI_API_KEY=your-gemini-api-key

# DeepSeek direct API -- only if you switch models back to deepseek: in config/settings.yaml
# DEEPSEEK_API_KEY=your-deepseek-api-key

# PubMed API key -- raises rate limit from 3 to 10 req/sec
# Get from: https://www.ncbi.nlm.nih.gov/account/settings/
PUBMED_API_KEY=your-pubmed-api-key

# IEEE Xplore -- required for IEEE database access
# Get from: https://developer.ieee.org/
IEEE_API_KEY=your-ieee-api-key

# Perplexity -- auxiliary "other sources" discovery connector
# Get from: https://docs.perplexity.ai/
PERPLEXITY_SEARCH_API_KEY=your-perplexity-api-key

# Semantic Scholar -- raises rate limit significantly
# Request from: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=your-s2-api-key

# Crossref -- polite crawling email (no account needed)
CROSSREF_EMAIL=your-email@example.com

# Elsevier Scopus / Embase -- API key from https://dev.elsevier.com/
# EMBASE_API_KEY falls back to SCOPUS_API_KEY when unset.
SCOPUS_API_KEY=your-scopus-api-key
# EMBASE_API_KEY=your-embase-api-key

# Operator Elsevier web login (Embase / ScienceDirect). Not used for API calls;
# sign in via browser, then export cookies (see SCOPUS_SESSION_COOKIE_FILE).
# EMBASE_EMAIL=your-institutional-email@university.edu
# EMBASE_PASSWORD=your-elsevier-password

# Institutional web session (optional). Export cookies after logging into Embase
# or Scopus with EMBASE_EMAIL (Chrome: Get cookies.txt LOCALLY). Store outside repo.
# SCOPUS_SESSION_COOKIE_FILE=~/.config/litreview/scopus-cookies.txt
# EMBASE_SESSION_COOKIE_FILE=~/.config/litreview/embase-cookies.txt

# Elsevier institutional token for ScienceDirect PDF API (optional).
# Request from library / datasupportRD@elsevier.com with your API key.
# SCOPUS_INSTTOKEN=your-institutional-token
# ELSEVIER_INSTTOKEN=your-institutional-token

# Operator-provided PDFs when automation cannot retrieve paywalled full text.
# Filenames must contain the paper DOI (e.g. 10.1016_j.jamda.2024.01.014.pdf).
# FULLTEXT_MANUAL_PDF_DIR=~/.config/litreview/manual_pdfs
